# ZapFlow — configuração de produção no Railway

# Configuração pública do Supabase. O backend também possui fallback oficial.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional para o fluxo principal. Necessária somente se você quiser persistir
# os webhooks/eventos da Evolution pelo endpoint do ZapFlow.
# Nunca exponha esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API. Também pode ser configurada por organização na tela WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Opcional: quando configurado, a Evolution pode enviar eventos para o ZapFlow.
GATEWAY_WEBHOOK_SECRET=

# O worker persistente usa um segredo gerenciado automaticamente no Supabase Vault.
# Não é necessário cadastrar CAMPAIGN_WORKER_SECRET manualmente no Railway.

# Espaçamento planejado por sessão na criação da fila.
# O código nunca permite menos de 10 segundos.
CAMPAIGN_SEND_DELAY_MS=15000
