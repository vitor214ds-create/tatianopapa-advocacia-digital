# ZapFlow — configuração de produção no Railway

# Configuração pública do Supabase. O backend também possui fallback oficial.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Evolution API. Também pode ser configurada por organização na tela WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# O webhook da Evolution e o worker persistente usam segredos gerenciados
# automaticamente no Supabase Vault. Não é necessário cadastrar service-role,
# GATEWAY_WEBHOOK_SECRET ou CAMPAIGN_WORKER_SECRET no Railway.

# Espaçamento planejado por sessão na criação da fila.
# O código nunca permite menos de 10 segundos.
CAMPAIGN_SEND_DELAY_MS=15000
