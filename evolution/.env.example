# Copie para evolution/.env no servidor. NUNCA versione o .env real.

# URL pública HTTPS da sua Evolution API após configurar domínio/reverse proxy.
SERVER_URL=https://evolution.seudominio.com

# Gere valores fortes antes de subir.
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Evolution API
DEL_INSTANCE=false
QRCODE_LIMIT=30
QRCODE_COLOR=#198754
LOG_LEVEL=ERROR,WARN

# WhatsApp/Baileys
CONFIG_SESSION_PHONE_CLIENT=ZapFlow
CONFIG_SESSION_PHONE_NAME=Chrome

# Webhook global fica desativado; o ZapFlow registra webhook por instância.
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
